{
    "rewrites": [
      { "source": "/agworld-v3-proxy/au/(.*)", "destination": "https://au.agworld.com/$1" },
      { "source": "/agworld-v3-proxy/us/(.*)", "destination": "https://us.agworld.com/$1" },
      { "source": "/agworld-v3-proxy/nz/(.*)", "destination": "https://nz.agworld.co/$1" },
      { "source": "/silo-proxy/(.*)", "destination": "https://www.longpaddock.qld.gov.au/$1" },
      { "source": "/dpird-proxy/(.*)", "destination": "https://api.agric.wa.gov.au/v2/weather/$1" },
      { "source": "/bom-proxy/(.*)", "destination": "https://www.bom.gov.au/$1" },
      { "source": "/rapidapi-proxy/(.*)", "destination": "https://meteostat.p.rapidapi.com/$1" },
      { "source": "/p/:code", "destination": "https://hmxxqacnzxqpcheoeidn.supabase.co/functions/v1/redirect?code=:code" },
      { "source": "/(.*)", "destination": "/index.html" }
    ],
    "cleanUrls": true,
    "trailingSlash": false
  }